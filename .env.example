# Адрес сервиса без слэша в конце: ссылки входа и превью в чатах.
APP_URL=http://localhost:3000

# PostgreSQL. Пусто — PGlite в .data/pglite (только для разработки).
DATABASE_URL=

# Папка для фото. Пусто — .data/uploads.
UPLOAD_DIR=

# Яндекс ID: oauth.yandex.ru, доступ к почте и имени.
# Redirect URI: ${APP_URL}/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# VK ID: id.vk.ru/about/business, доступ к почте.
# Redirect URI: ${APP_URL}/auth/vk/callback
VK_CLIENT_ID=

# Почта администраторов через запятую: при входе получают роль admin.
ADMIN_EMAILS=

# Подставной провайдер входа для разработки и автотестов. На сервере не работает.
AUTH_DEV_PROVIDER=1

# Ключ шифрования серверных действий, одинаковый между выкладками: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
